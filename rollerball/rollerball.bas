10 REM *** ROLLERBALL II (1986) ***
20 REM ORIGINAL BY THOMAS TAUSEND
30 GRAPHICS 0:SETCOLOR 2,0,0:SETCOLOR 4,0,0:PRINT "   *** ROLLERBALL II ***"
40 POKE 752,1:X=20:Y=12:SCORE=0:DIR=1
50 REM FIELD GENERATION
60 FOR I=1 TO 40:PRINT "#";:NEXT I
70 FOR I=1 TO 20:PRINT "#";:SPACES=INT(RND(0)*30)+4
80 FOR J=1 TO 38:IF J=SPACES THEN PRINT "X";:GOTO 100
90 IF RND(0)>0.85 THEN PRINT "#"; ELSE PRINT " ";
100 NEXT J:PRINT "#";:NEXT I
110 FOR I=1 TO 40:PRINT "#";:NEXT I
120 REM MAIN GAME LOOP
130 POSITION X,Y:PRINT "O";
140 K=PEEK(764):IF K=255 THEN GOTO 180
150 POKE 764,255:REM RESET KEY
160 IF K=134 THEN DIR=-1:REM LEFT ARROW / A
170 IF K=135 THEN DIR=1:REM RIGHT ARROW / D
180 POSITION X,Y:PRINT " ";
190 X=X+DIR:IF X<1 OR X>38 THEN GOTO 250
200 REM COLLISION CHECK
210 LOCATE X,Y,HIT
220 IF HIT=35 THEN GOTO 250:REM HIT WALL (#)
230 IF HIT=88 THEN SCORE=SCORE+100:REM HIT TARGET (X)
240 POSITION X,Y:PRINT "O";:POKE 77,0:GOTO 130
250 GRAPHICS 0:PRINT "GAME OVER! SCORE: ";SCORE
260 PRINT "PRESS START TO RESTART":IF PEEK(53279)<>6 THEN GOTO 260
270 GOTO 30
